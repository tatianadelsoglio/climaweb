                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "@theme {\n  --color-sky-top: #173F86;\n  --color-sky-bottom: #2858A3;\n  --color-sky-glow: #FFB86B47;\n  --color-glass: #FFFFFF1A;\n  --color-glass-strong: #FFFFFF29;\n  --color-glass-line: #FFFFFF33;\n  --color-accent: #FFC56B;\n  --color-on-accent: #14161F;\n  --color-focus: #FFFFFF;\n  --color-panel: #FFFFFF;\n  --color-panel-ink: #12172A;\n  --color-panel-muted: #535A6E;\n  --color-panel-highlight: #EBEEFF;\n  --color-danger: #FFB4A8;\n  --color-skeleton: #FFFFFF24;\n  --color-fg: #FFFFFF;\n  --color-fg-muted: #FFFFFFE0;\n\n  --font-display: var(--font-bricolage-grotesque);\n  --font-sans: var(--font-figtree);\n\n  --text-micro: 12px;\n  --text-overline: 13px;\n  --text-caption: 14px;\n  --text-body: 16px;\n  --text-button: 17px;\n  --text-lead: 18px;\n  --text-subtitle: 20px;\n  --text-stat: 22px;\n  --text-title: 24px;\n  --text-title-lg: 28px;\n  --text-heading-sm: 36px;\n  --text-heading: 40px;\n  --text-hero-mobile: 48px;\n  --text-display: 56px;\n  --text-hero-desktop: 88px;\n  --text-temp-mobile: 136px;\n  --text-temp-desktop: 232px;\n\n  --spacing-3xs: 2px;\n  --spacing-toggle: 3px;\n  --spacing-2xs: 4px;\n  --spacing-xs: 6px;\n  --spacing-sm: 8px;\n  --spacing-field: 10px;\n  --spacing-md: 12px;\n  --spacing-inset: 14px;\n  --spacing-lg: 16px;\n  --spacing-chip: 18px;\n  --spacing-xl: 20px;\n  --spacing-card: 22px;\n  --spacing-2xl: 24px;\n  --spacing-3xl: 28px;\n  --spacing-4xl: 32px;\n  --spacing-5xl: 48px;\n  --spacing-control: 56px;\n  --spacing-gutter: 64px;\n\n  --radius-xs: 6px;\n  --radius-sm: 12px;\n  --radius-md: 14px;\n  --radius-lg: 20px;\n  --radius-xl: 24px;\n  --radius-2xl: 28px;\n  --radius-pill: 9999px;\n}\n\n[data-sky=\"clear-night\"] {\n  --color-sky-top: #090D22;\n  --color-sky-bottom: #1E2557;\n  --color-sky-glow: #7C8CFF40;\n  --color-accent: #C7CEFF;\n}\n\n[data-sky=\"rain\"] {\n  --color-sky-top: #1B2631;\n  --color-sky-bottom: #33495B;\n  --color-sky-glow: #8FB3C940;\n  --color-accent: #A8DCEC;\n}",
                  "lineHeight": 1.55,
                  "fontFamily": "Geist Mono",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
