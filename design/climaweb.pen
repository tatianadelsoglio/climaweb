                  "fill": "#ECEEF2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "@theme {\n  --color-bg: #F5F4F0;\n  --color-surface: #FFFFFF;\n  --color-surface-sunken: #E9E7E1;\n  --color-ink: #15171C;\n  --color-ink-muted: #575C66;\n  --color-line: #DAD7CF;\n  --color-line-strong: #868A93;\n  --color-accent: #2A55D6;\n  --color-on-accent: #FFFFFF;\n  --color-accent-soft: #E4EAFB;\n  --color-focus: #2A55D6;\n  --color-danger: #B42318;\n  --color-danger-soft: #FBE9E7;\n  --color-warn: #7A5000;\n  --color-warn-soft: #FFF2D6;\n  --color-temp-cold: #4E7BD9;\n  --color-temp-warm: #D9822B;\n  --color-tint: #FFE7C2;\n\n  --font-sans: var(--font-geist-sans);\n  --font-mono: var(--font-geist-mono);\n\n  --text-micro: 12px;\n  --text-caption: 13px;\n  --text-body: 15px;\n  --text-lead: 17px;\n  --text-title: 22px;\n  --text-heading: 32px;\n  --text-display: 44px;\n  --text-temp-mobile: 112px;\n  --text-temp-desktop: 176px;\n\n  --spacing-3xs: 2px;\n  --spacing-toggle: 3px;\n  --spacing-2xs: 4px;\n  --spacing-xs: 6px;\n  --spacing-sm: 8px;\n  --spacing-field: 10px;\n  --spacing-md: 12px;\n  --spacing-inset: 14px;\n  --spacing-lg: 16px;\n  --spacing-xl: 20px;\n  --spacing-2xl: 24px;\n  --spacing-3xl: 32px;\n  --spacing-4xl: 40px;\n  --spacing-control: 52px;\n  --spacing-5xl: 56px;\n  --spacing-6xl: 72px;\n  --spacing-gutter: 80px;\n  --spacing-7xl: 96px;\n\n  --radius-xs: 4px;\n  --radius-sm: 6px;\n  --radius-md: 10px;\n  --radius-lg: 14px;\n  --radius-pill: 9999px;\n}\n\n[data-theme=\"night\"] {\n  --color-bg: #0F1115;\n  --color-surface: #171A21;\n  --color-surface-sunken: #1F232C;\n  --color-ink: #ECEEF2;\n  --color-ink-muted: #A3A9B5;\n  --color-line: #2A2F39;\n  --color-line-strong: #6B717D;\n  --color-accent: #8DA8FF;\n  --color-on-accent: #0F1115;\n  --color-accent-soft: #1C2540;\n  --color-focus: #8DA8FF;\n  --color-danger: #FF8A80;\n  --color-danger-soft: #3A1C1A;\n  --color-warn: #F5C46B;\n  --color-warn-soft: #33270F;\n  --color-temp-cold: #7C9BEA;\n  --color-temp-warm: #E9A55E;\n  --color-tint: #1B2440;\n}",
                  "lineHeight": 1.55,
                  "fontFamily": "Geist Mono",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
