{
  "version": "2.22",
  "children": [
    {
      "type": "frame",
      "id": "HGQ6T",
      "x": 0,
      "y": 0,
      "name": "Dirección A — Papel (minimalista)",
      "theme": {
        "a-mode": "day"
      },
      "fill": "#E7E5DF",
      "layout": "vertical",
      "gap": 120,
      "padding": 120,
      "children": [
        {
          "type": "frame",
          "id": "gKe4G",
          "name": "Overview A",
          "gap": 80,
          "children": [
            {
              "type": "frame",
              "id": "QFBGp",
              "name": "Intro",
              "width": 560,
              "layout": "vertical",
              "gap": 24,
              "children": [
                {
                  "type": "text",
                  "id": "ZHV0Q",
                  "name": "Eyebrow",
                  "fill": "#2A55D6",
                  "content": "DIRECCIÓN A",
                  "fontFamily": "Geist Mono",
                  "fontSize": 14,
                  "fontWeight": "normal",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "FjBJq",
                  "name": "Title",
                  "fill": "#15171C",
                  "content": "Papel",
                  "fontFamily": "Geist",
                  "fontSize": 96,
                  "fontWeight": "600",
                  "letterSpacing": -3
                },
                {
                  "type": "text",
                  "id": "FFEcb",
                  "name": "Sub",
                  "fill": "#3B3F47",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Minimalista editorial. El dato es el protagonista; todo lo demás es tipografía, aire y una línea fina.",
                  "lineHeight": 1.4,
                  "fontFamily": "Geist",
                  "fontSize": 22,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "qU4Lb",
                  "name": "Qué transmite",
                  "width": "fill_container",
                  "stroke": "#C9C6BD",
                  "strokeWidth": {
                    "top": 1
                  },
                  "layout": "vertical",
                  "gap": 10,
                  "padding": [
                    20,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "A0KtTT",
                      "name": "h",
                      "fill": "#15171C",
                      "content": "Qué transmite",
                      "fontFamily": "Geist",
                      "fontSize": 18,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "g8eM6D",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— Calma, precisión y confianza: se lee como un buen diario o un instrumento de medición.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "PMccU",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— Un tinte cálido (día) o azul profundo (noche) en la esquina superior marca el momento del día sin distraer.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "pMHgB",
                  "name": "Ventajas",
                  "width": "fill_container",
                  "stroke": "#C9C6BD",
                  "strokeWidth": {
                    "top": 1
                  },
                  "layout": "vertical",
                  "gap": 10,
                  "padding": [
                    20,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "aDNBH",
                      "name": "h",
                      "fill": "#15171C",
                      "content": "Ventajas",
                      "fontFamily": "Geist",
                      "fontSize": 18,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "rFGJB",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— Usa Geist, que ya está cargada en el proyecto: cero dependencias nuevas.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "S9Nw2",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— Contrastes AA holgados en día y noche; fácil de mantener y de extender.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "zb89N",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— Liviano de implementar: sin imágenes, sin blur, pocos gradientes.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "N2zvNL",
                  "name": "Desventajas",
                  "width": "fill_container",
                  "stroke": "#C9C6BD",
                  "strokeWidth": {
                    "top": 1
                  },
                  "layout": "vertical",
                  "gap": 10,
                  "padding": [
                    20,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "N9tdY",
                      "name": "h",
                      "fill": "#15171C",
                      "content": "Desventajas",
                      "fontFamily": "Geist",
                      "fontSize": 18,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "IHMkx",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— Menos memorable en un portfolio: puede leerse como “otra app limpia”.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "O3CBSR",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— La atmósfera del clima se comunica poco; depende mucho de los íconos.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "mZCZR",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— El vacío del estado inicial exige buen copy para no sentirse vacío.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "jvqLF",
                  "name": "Accesibilidad",
                  "width": "fill_container",
                  "stroke": "#C9C6BD",
                  "strokeWidth": {
                    "top": 1
                  },
                  "layout": "vertical",
                  "gap": 10,
                  "padding": [
                    20,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "KhryP",
                      "name": "h",
                      "fill": "#3B3F47",
                      "content": "Accesibilidad (WCAG 2.1 AA)",
                      "fontFamily": "Geist",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "s0pvn",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— Texto principal ≥ 15:1 y atenuado ≥ 6:1 en día y noche; bordes de controles ≥ 3:1 contra el fondo.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "lb7MM",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— Foco: anillo de 2px en --color-focus con 2px de separación (ver chip “Buenos Aires” y campo activo).",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "tjZf5",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— Controles de 52px y botones/segmentos de 44px como mínimo.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "B5FpNn",
                      "name": "item",
                      "fill": "#3B3F47",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "— Buscador como combobox ARIA: listbox, aria-activedescendant, ↑ ↓ Enter Esc; errores con role=alert y aria-describedby.",
                      "lineHeight": 1.5,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
